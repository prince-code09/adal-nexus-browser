# ====================================================================
# AdaL Nexus — Environment Configuration Template
# ====================================================================

# Default AI / LLM Provider: 'mock' (default for Phase 1), 'gemini', 'openai', 'anthropic', 'custom'
DEFAULT_LLM_PROVIDER=mock

# Google Gemini API Key (Required for Phase 2 when using Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Required for Phase 2 when using OpenAI)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (Required for Phase 2 when using Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model identifier
LLM_MODEL=gemini-1.5-pro-latest

# Optional Custom Base URL (e.g. for Ollama or Local proxy)
LLM_BASE_URL=

# Browser Execution Mode: 'false' for visible Chromium window, 'true' for headless
HEADLESS_BROWSER=false

# WebSocket Event Server Port
WS_PORT=5174

# Google Workspace Integration (Phase 2)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REFRESH_TOKEN=your_google_refresh_token_here

# GitHub Integration (Phase 2)
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_pat_here
